# Deccan Dentics environment. Copy to .env.local and fill in the values. Never commit real values.

# Neon Postgres connection string for the Deccan Dentics database (Neon Console → Connect).
DATABASE_URL=

# Neon Auth (Neon Console → Auth → Enable Auth; the Auth URL is under Settings → Project Info).
NEON_AUTH_BASE_URL=
# At least 32 characters: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=
# Who may sign up and open the admin, comma separated.
ADMIN_EMAILS=

# Mail account the booking emails are sent from. Gmail needs an app password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_FROM_NAME=Deccan Dentics
# Comma-separated: every address gets the clinic's new-booking email.
ADMIN_NOTIFY_EMAIL=

# Public address used in email links. Leave empty to use the deployment host URL when available.
SITE_URL=
